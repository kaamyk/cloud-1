# HTTP: only redirects to HTTPS
server {
    listen 80;
    server_name _;

    return 301 https://$host$request_uri;
}

# HTTPS: serves WordPress on / and phpMyAdmin on /phpmyadmin/
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/cloud1.crt;
    ssl_certificate_key /etc/nginx/certs/cloud1.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /var/www/html;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # phpMyAdmin. "^~" = if this prefix matches, do NOT test the regex
    # locations below; otherwise "~ \.php$" would send /phpmyadmin/*.php
    # to WordPress's php-fpm.
    location = /phpmyadmin {
        return 301 https://$host/phpmyadmin/;
    }

    location ^~ /phpmyadmin/ {
        # Trailing "/" = strip the /phpmyadmin/ prefix: phpMyAdmin lives at "/".
        proxy_pass http://phpmyadmin:80/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass wordpress:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}
