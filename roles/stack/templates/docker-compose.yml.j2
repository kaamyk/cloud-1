version: "3"

volumes:
  wordpress:
    driver: local
    driver_opts:
      type: none
      device: /home/anvincen/data
      o: bind
  db_data:
    driver: local
    driver_opts:
      type: none
      device: /home/anvincen/data
      o: bind

networks:
  inception:
    name: inception
    driver: bridge

services:
  mariadb:
    container_name: mariadb
    build: ./requirements/mariadb/
    image: mariadb
    volumes:
      - db_data:/var/lib/mysql
    # ports:
    # - 3306:3306
    networks:
      - inception
    env_file:
      - .env
    restart:  always
  nginx:
    container_name: nginx
    build:  ./requirements/nginx/.
    image:  nginx
    depends_on:
      - wordpress
    ports:
      - "443:443"
    networks:
      - inception
    volumes:
      - wordpress:/var/www/html
    restart:  always
  wordpress:
    container_name: wordpress
    build:  ./requirements/wordpress/.
    image:  wordpress
    ports:
      - 9000:9000
    networks:
      - inception
    depends_on:
      - mariadb
    volumes:
      - wordpress:/var/www/html
    env_file:
      - .env
    restart:  always
