volumes:
  wordpress:
    driver: local
  db_data:
    driver: local

networks:
  inception:
    name: inception
    driver: bridge

services:
  mysql:
    container_name: mysql
    image: mysql:8.4
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - inception
    env_file:
      - .env
    restart:  always
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
        
  nginx:
    container_name: nginx
    image:  nginx:stable-alpine
    depends_on:
      - wordpress
      - phpmyadmin
    ports:
      - "80:80"
      - "443:443"
    networks:
      - inception
    volumes:
      - wordpress:/var/www/html
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./certs:/etc/nginx/certs:ro
    restart:  always
    
  wordpress:
    container_name: wordpress
    image:  wordpress:6-fpm
    networks:
      - inception
    depends_on:
      mysql:
        condition: service_healthy
    volumes:
      - wordpress:/var/www/html
    env_file:
      - .env
    restart:  always

  # Reached only through nginx (https://<host>/phpmyadmin/), no published port.
  phpmyadmin:
    container_name: phpmyadmin
    image: phpmyadmin:5-apache
    networks:
      - inception
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      PMA_HOST: mysql
      PMA_ABSOLUTE_URI: "{{ wp_url }}/phpmyadmin/"
    volumes:
      - ./pma.config.user.inc.php:/etc/phpmyadmin/config.user.inc.php:ro
    restart: always

  wpcli:
    image: wordpress:cli
    networks:
      - inception
    profiles: ["cli"]
    user: "33:33"
    depends_on:
      mysql:
        condition: service_healthy
      wordpress:
        condition: service_started
    volumes:
      - wordpress:/var/www/html
    env_file:
      .env
