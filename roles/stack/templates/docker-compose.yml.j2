volumes:
  wordpress:
    driver: local
  db_data:
    driver: local

networks:
  inception:
    name: inception
    driver: bridge

services:
  mysql:
    container_name: mysql
    image: mysql:8.4
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - inception
    env_file:
      - .env
    restart:  always
  nginx:
    container_name: nginx
    image:  nginx:stable-alpine
    depends_on:
      - wordpress
    ports:
      - "80:80"
      - "443:443"
    networks:
      - inception
    volumes:
      - wordpress:/var/www/html
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    restart:  always
  wordpress:
    container_name: wordpress
    image:  wordpress:6-fpm
    networks:
      - inception
    depends_on:
      - mysql
    volumes:
      - wordpress:/var/www/html
    env_file:
      - .env
    restart:  always
